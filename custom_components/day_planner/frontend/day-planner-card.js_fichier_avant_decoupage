class DayPlannerCard extends HTMLElement {
  constructor() {
    super();

    this.attachShadow({ mode: "open" });

    this._hass = null;
    this._config = {};

    const now = new Date();

    this._displayYear = now.getFullYear();
    this._displayMonth = now.getMonth();

    this._selectedDate = this._formatDate(now);

    this._calendar = null;
    this._loading = false;
    this._error = null;
    this._loadedMonthKey = null;
  }

  setConfig(config) {
    this._config = config || {};
  }

  set hass(hass) {
    this._hass = hass;

    const monthKey =
      `${this._displayYear}-${String(
        this._displayMonth + 1
      ).padStart(2, "0")}`;

    if (
      !this._loading &&
      this._loadedMonthKey !== monthKey
    ) {
      this._loadCalendar();
      return;
    }

    this.render();
  }

  getCardSize() {
    return 8;
  }

  getGridOptions() {
    return {
      columns: "full",
      rows: "auto",
    };
  }

  setConfig(config) {
    this._config = config || {};
    this.style.display = "block";
    this.style.width = "100%";
  }

  _formatDate(date) {
    const year = date.getFullYear();
    const month = String(
      date.getMonth() + 1
    ).padStart(2, "0");
    const day = String(
      date.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
  }

  _monthStart() {
    return new Date(
      this._displayYear,
      this._displayMonth,
      1
    );
  }

  _monthEnd() {
    return new Date(
      this._displayYear,
      this._displayMonth + 1,
      0
    );
  }

  async _loadCalendar() {
    if (!this._hass) {
      return;
    }

    this._loading = true;
    this._error = null;

    this.render();

    try {
      const startDate =
        this._formatDate(
          this._monthStart()
        );

      const endDate =
        this._formatDate(
          this._monthEnd()
        );

      this._calendar =
        await this._hass.callWS({
          type: "day_planner/get_calendar",
          start_date: startDate,
          end_date: endDate,
        });

      this._loadedMonthKey =
        `${this._displayYear}-${String(
          this._displayMonth + 1
        ).padStart(2, "0")}`;

      const exists =
        this._calendar.days.some(
          (day) =>
            day.date === this._selectedDate
        );

      if (!exists) {
        this._selectedDate =
          this._calendar.days[0]?.date ??
          null;
      }
    } catch (error) {
      console.error(
        "Day Planner calendar error",
        error
      );

      this._error =
        error?.message ||
        "Impossible de charger le calendrier.";
    } finally {
      this._loading = false;
      this.render();
    }
  }

  _previousMonth() {
    if (this._displayMonth === 0) {
      this._displayMonth = 11;
      this._displayYear -= 1;
    } else {
      this._displayMonth -= 1;
    }

    this._loadedMonthKey = null;

    this._loadCalendar();
  }

  _nextMonth() {
    if (this._displayMonth === 11) {
      this._displayMonth = 0;
      this._displayYear += 1;
    } else {
      this._displayMonth += 1;
    }

    this._loadedMonthKey = null;

    this._loadCalendar();
  }

  _selectDate(date) {
    this._selectedDate = date;
    this.render();
  }

  _monthLabel() {
    return new Intl.DateTimeFormat(
      this._hass?.locale?.language ||
        "fr-FR",
      {
        month: "long",
        year: "numeric",
      }
    ).format(
      new Date(
        this._displayYear,
        this._displayMonth,
        1
      )
    );
  }

  _selectedDay() {
    if (!this._calendar) {
      return null;
    }

    return (
      this._calendar.days.find(
        (day) =>
          day.date === this._selectedDate
      ) || null
    );
  }

  _renderCalendar() {
    if (!this._calendar) {
      return "";
    }

    const firstDay =
      this._monthStart();

    /*
     * JS:
     * Sunday = 0
     * Monday = 1
     *
     * We want:
     * Monday = 0
     * ...
     * Sunday = 6
     */
    const leadingEmpty =
      (firstDay.getDay() + 6) % 7;

    const cells = [];

    for (
      let index = 0;
      index < leadingEmpty;
      index += 1
    ) {
      cells.push(
        `<div class="day empty"></div>`
      );
    }

    for (
      const day of this._calendar.days
    ) {
      const date = new Date(
        `${day.date}T12:00:00`
      );

      const selected =
        day.date === this._selectedDate;

      const exception =
        day.calendar_exception_id
          ? " exception"
          : "";

      const dayType =
        day.day_type?.name || "";

    const dayColor =
      this._dayTypeColor(
        day.day_type
      );

    cells.push(`
      <button
        class="day${selected ? " selected" : ""}${exception}"
        data-date="${day.date}"
        type="button"
        style="
          --day-type-color:
            ${dayColor};
        "
      >
        <div class="day-header">
          <span class="day-number">
            ${date.getDate()}
          </span>

          ${
            day.calendar_exception_id
              ? `
                <ha-icon
                  class="exception-icon"
                  icon="mdi:calendar-alert"
                ></ha-icon>
              `
              : ""
          }
        </div>

        ${
          dayType
            ? `
              <span class="day-type">
                ${this._escapeHtml(dayType)}
              </span>
            `
            : ""
        }
      </button>
    `);


    }

    return `
      <div class="weekdays">
        <span>Lun</span>
        <span>Mar</span>
        <span>Mer</span>
        <span>Jeu</span>
        <span>Ven</span>
        <span>Sam</span>
        <span>Dim</span>
      </div>

      <div class="calendar-grid">
        ${cells.join("")}
      </div>
    `;
  }

  _renderSelectedDay() {
    const day = this._selectedDay();

    if (!day) {
      return "";
    }

    const label =
      new Intl.DateTimeFormat(
        this._hass?.locale?.language ||
          "fr-FR",
        {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        }
      ).format(
        new Date(
          `${day.date}T12:00:00`
        )
      );

    const moments =
      day.scheduled_moments || [];

    return `
      <div class="details">
        <div class="details-title">
          ${this._escapeHtml(label)}
        </div>

        <div class="details-meta">
          <span>
            Type :
            <strong>
              ${
                day.day_type?.name
                  ? this._escapeHtml(
                      day.day_type.name
                    )
                  : "Aucun"
              }
            </strong>
          </span>

          ${
            day.calendar_exception_id
              ? `
                <span class="exception-label">
                  Exception
                </span>
              `
              : ""
          }
        </div>
 
        ${this._renderTimeline(day)}

        ${
          moments.length
            ? `
              <div class="moments">
                ${moments
                  .map(
                    (item) => `
                      <div class="moment-row">
                        <div class="moment-time">
                          ${this._formatTime(
                            item.time_definition
                              ?.fixed_time
                          )}
                        </div>

                        <div class="moment-icon">
                          ${
                            item.moment?.icon
                              ? `
                                <ha-icon
                                  icon="${this._escapeHtml(
                                    item.moment.icon
                                  )}"
                                ></ha-icon>
                              `
                              : ""
                          }
                        </div>

                        <div class="moment-name">
                          ${this._escapeHtml(
                            item.moment?.name ||
                              item.moment?.id ||
                              ""
                          )}
                        </div>
                      </div>
                    `
                  )
                  .join("")}
              </div>
            `
            : `
              <div class="empty-moments">
                Aucun moment programmé.
              </div>
            `
        }
      </div>
    `;
  }

  _formatTime(value) {
    if (!value) {
      return "";
    }

    return value.slice(0, 5);
  }

  _escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  _bindEvents() {
    this.shadowRoot.querySelector(
      "#previous-month"
    )?.addEventListener(
      "click",
      () => this._previousMonth()
    );

    this.shadowRoot.querySelector(
      "#next-month"
    )?.addEventListener(
      "click",
      () => this._nextMonth()
    );

    this.shadowRoot.querySelectorAll(
      ".day[data-date]"
    ).forEach((element) => {
      element.addEventListener(
        "click",
        () => {
          this._selectDate(
            element.dataset.date
          );
        }
      );
    });
  }

  render() {
    if (!this._hass) {
      return;
    }

    this.shadowRoot.innerHTML = `
      <ha-card>
        <style>
          .container {
            width: 100%;
            box-sizing: border-box;
            padding: 16px;
          }          

          .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
          }

          .title {
            font-size: 20px;
            font-weight: 600;
          }

          .month-navigation {
            display: flex;
            align-items: center;
            gap: 8px;
          }

          .month-label {
            min-width: 160px;
            text-align: center;
            font-weight: 500;
            text-transform: capitalize;
          }

          .navigation-button {
            border: 0;
            background: transparent;
            cursor: pointer;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            color: var(--primary-text-color);
          }

          .navigation-button:hover {
            background:
              var(--secondary-background-color);
          }

          .weekdays,
          .calendar-grid {
              display: grid;
              width: 100%;
              grid-template-columns: repeat(7, 1fr);
              gap: 4px;
              box-sizing: border-box;
          }

          .weekdays {
            margin-bottom: 4px;
          }

          .weekdays span {
            text-align: center;
            font-size: 12px;
            font-weight: 600;
            color:
              var(--secondary-text-color);
            padding: 6px 2px;
          }

          .day {
            min-height: 72px;
            border: 1px solid
              var(--divider-color);
            border-radius: 8px;
            background:
              var(--card-background-color);
            color:
              var(--primary-text-color);
            padding: 6px;
            text-align: left;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 6px;
             width: 100%;
             min-width: 0;
             box-sizing: border-box;
          }

          .day.empty {
            border-color: transparent;
            background: transparent;
            cursor: default;
          }

          .day:hover:not(.empty) {
            background:
              var(--secondary-background-color);
          }

          .day.selected {
            outline: 2px solid
              var(--primary-color);
            outline-offset: -2px;
          }

          .day.exception {
            border-left: 4px solid
              var(--warning-color);
          }

          .day-number {
            font-weight: 600;
          }

          .day-type {
            font-size: 11px;
            color:
              var(--secondary-text-color);
            overflow: hidden;
            text-overflow: ellipsis;
          }

          .details {
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid
              var(--divider-color);
          }

          .details-title {
            font-size: 18px;
            font-weight: 600;
            text-transform: capitalize;
          }

          .details-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 6px;
            color:
              var(--secondary-text-color);
          }

          .exception-label {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 12px;
            background:
              var(--warning-color);
            color:
              var(--text-primary-color);
          }

          .moments {
            margin-top: 14px;
          }

          .moment-row {
            display: grid;
            grid-template-columns:
              60px 32px 1fr;
            align-items: center;
            min-height: 42px;
            border-bottom: 1px solid
              var(--divider-color);
          }

          .moment-time {
            font-weight: 600;
          }

          .moment-icon {
            display: flex;
            align-items: center;
          }

          .moment-name {
            font-size: 14px;
          }

          .empty-moments {
            margin-top: 16px;
            color:
              var(--secondary-text-color);
          }

          .loading,
          .error {
            padding: 24px;
            text-align: center;
          }

          .error {
            color:
              var(--error-color);
          }

          @media (max-width: 600px) {
            .container {
              padding: 10px;
            }

            .header {
              align-items: flex-start;
              flex-direction: column;
            }

            .day {
              min-height: 58px;
              padding: 4px;
            }

            .day-type {
              font-size: 9px;
            }
          }

          :host {
            display: block;
            width: 100%;
            min-width: 0;
          }
          ha-card {
            display: block;
            width: 100%;
            box-sizing: border-box;
          }
          .legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 16px;
            margin-bottom: 14px;
          }

          .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
          }

          .legend-color {
            width: 12px;
            height: 12px;
            border-radius: 3px;
          }

          .day {
            position: relative;
            min-height: 62px;
            border: 1px solid
              var(--divider-color);
            border-top: 4px solid
              var(--day-type-color);
          }

          .day-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
          }

          .exception-icon {
            --mdc-icon-size: 16px;
            color: var(--warning-color);
          }

          .day-type {
            display: block;
            width: 100%;
            font-size: 11px;
            font-weight: 500;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
          }

          .timeline-wrapper {
            margin-top: 22px;
            padding-top: 20px;
            padding-bottom: 55px;
            overflow: hidden;
          }

          .timeline-hours {
            position: relative;
            height: 18px;
            margin: 0 8px;
            color: var(--secondary-text-color);
            font-size: 10px;
          }

          .timeline-hour {
            position: absolute;
            transform: translateX(-50%);
          }

          .timeline {
            position: relative;
            height: 12px;
            margin: 6px 8px 0;
            border-radius: 6px;
            background:
              var(--divider-color);
          }

          .timeline::before {
            content: "";
            position: absolute;
            left: 25%;
            top: 0;
            bottom: 0;
            border-left: 1px solid
              var(--secondary-text-color);
            opacity: 0.2;
          }

          .timeline-marker {
            position: absolute;
            top: 50%;
            transform: translate(
              -50%,
              -50%
            );
          }

          .timeline-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background:
              var(--primary-color);
            border: 3px solid
              var(--card-background-color);
            box-sizing: border-box;
          }

          .timeline-label {
            position: absolute;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 80px;
            font-size: 11px;
            white-space: nowrap;
          }

          .timeline-label ha-icon {
            --mdc-icon-size: 18px;
            margin-bottom: 2px;
          }

          .timeline-label strong {
            font-size: 10px;
            color:
              var(--secondary-text-color);
          }

          .timeline-empty {
            margin-top: 16px;
            color:
              var(--secondary-text-color);
          }

        </style>

        <div class="container">
          <div class="header">
            <div class="title">
              Day Planner
            </div>

            <div class="month-navigation">
              <button
                id="previous-month"
                class="navigation-button"
                type="button"
                title="Mois précédent"
              >
                <ha-icon
                  icon="mdi:chevron-left"
                ></ha-icon>
              </button>

              <div class="month-label">
                ${this._escapeHtml(
                  this._monthLabel()
                )}
              </div>

              <button
                id="next-month"
                class="navigation-button"
                type="button"
                title="Mois suivant"
              >
                <ha-icon
                  icon="mdi:chevron-right"
                ></ha-icon>
              </button>
            </div>
          </div>

          ${
            this._loading
              ? `
                <div class="loading">
                  Chargement…
                </div>
              `
              : this._error
                ? `
                  <div class="error">
                    ${this._escapeHtml(
                      this._error
                    )}
                  </div>
                `
                : `
                  ${this._renderLegend()}
                  ${this._renderCalendar()}
                  ${this._renderSelectedDay()}
                `
          }
        </div>
      </ha-card>
    `;

    this._bindEvents();
  }

  _dayTypeColor(dayType) {
    if (!dayType?.id) {
      return "var(--divider-color)";
    }

    const colors = [
      "#4f8cff",
      "#42a66f",
      "#d28a32",
      "#a06bdd",
      "#d05f73",
      "#3d9ca8",
      "#aa8a42",
      "#6f8299",
    ];

    let hash = 0;

    for (const char of dayType.id) {
      hash =
        ((hash << 5) - hash) +
        char.charCodeAt(0);

      hash |= 0;
    }

    return colors[
      Math.abs(hash) % colors.length
    ];
  }

  _timeToPercent(value) {
    if (!value) {
      return 0;
    }

    const [hours, minutes] =
      value.split(":").map(Number);

    const totalMinutes =
      (hours * 60) + minutes;

    return (
      totalMinutes /
      (24 * 60)
    ) * 100;
  }

  _renderLegend() {
    if (!this._calendar) {
      return "";
    }

    const dayTypes = new Map();

    for (const day of this._calendar.days) {
      if (day.day_type) {
        dayTypes.set(
          day.day_type.id,
          day.day_type
        );
      }
    }

    if (!dayTypes.size) {
      return "";
    }

    return `
      <div class="legend">
        ${[...dayTypes.values()]
          .map(
            (dayType) => `
              <div class="legend-item">
                <span
                  class="legend-color"
                  style="
                    background:
                      ${this._dayTypeColor(dayType)};
                  "
                ></span>

                <span>
                  ${this._escapeHtml(
                    dayType.name
                  )}
                </span>
              </div>
          `
          )
          .join("")}
      </div>
    `;
  }

  _renderTimeline(day) {
    const moments =
      day?.scheduled_moments || [];

    if (!moments.length) {
      return `
        <div class="timeline-empty">
          Aucun moment programmé.
        </div>
      `;
    }

    const hours = [];

    for (let hour = 0; hour <= 24; hour += 2) {
      hours.push(`
        <span
          class="timeline-hour"
          style="
            left: ${(hour / 24) * 100}%;
          "
        >
          ${String(hour).padStart(2, "0")}
        </span>
      `);
    }

    const markers = moments
      .map((item) => {
        const time =
          item.time_definition?.fixed_time;

        const position =
          this._timeToPercent(time);

        return `
          <div
            class="timeline-marker"
            style="
              left: ${position}%;
            "
            title="${this._escapeHtml(
              `${this._formatTime(time)} - ${
                item.moment?.name || ""
              }`
            )}"
          >
            <div class="timeline-dot">
            </div>

            <div class="timeline-label">
              ${
                item.moment?.icon
                  ? `
                    <ha-icon
                      icon="${this._escapeHtml(
                        item.moment.icon
                      )}"
                    ></ha-icon>
                `
                  : ""
              }

              <span>
                ${this._escapeHtml(
                  item.moment?.name ||
                  item.moment?.id ||
                  ""
                )}
              </span>

              <strong>
                ${this._formatTime(time)}
              </strong>
            </div>
          </div>
        `;
      })
      .join("");

    return `
      <div class="timeline-wrapper">
        <div class="timeline-hours">
          ${hours.join("")}
        </div>

        <div class="timeline">
          ${markers}
        </div>
      </div>
    `;
  }

}

customElements.define(
  "day-planner-card",
  DayPlannerCard
);

